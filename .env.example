# --- required
NOUS_DRIVE_DATABASE_URL=postgresql://postgres:postgres@db:5432/nous
NOUS_DRIVE_SECRET_KEY=change-me-long-random-string
# Fernet key for OAuth tokens at rest:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOUS_DRIVE_ENCRYPTION_KEY=
# Public HTTPS URL of the API (OAuth redirect, Drive webhooks, links in MCP results)
NOUS_DRIVE_PUBLIC_BASE_URL=https://drive.nous.example
# Public URL of the MCP HTTP endpoint (Claude clients hit this). Defaults to PUBLIC_BASE_URL/mcp
# when a reverse proxy mounts the mcp service there. Set explicitly if MCP is on another host/port.
# NOUS_DRIVE_MCP_PUBLIC_URL=https://drive.nous.example/mcp

# --- Google OAuth client (Web application). Redirect URI: <PUBLIC_BASE_URL>/oauth/google/callback
NOUS_DRIVE_GOOGLE_CLIENT_ID=
NOUS_DRIVE_GOOGLE_CLIENT_SECRET=

# --- Email magic-link sign-in (Resend; same pattern as Halqa)
RESEND_API_KEY=
NOUS_DRIVE_EMAIL_FROM="Nous Drive <noreply@nous.org.in>"
# Return the sign-in URL in the API response (local/dev only)
NOUS_DRIVE_DEV_LINKS=0

# --- notifications outside MCP (any combination; leave empty to disable)
NOUS_DRIVE_SLACK_WEBHOOK_URL=
NOUS_DRIVE_NOTIFY_WEBHOOK_URL=
NOUS_DRIVE_SMTP_HOST=
NOUS_DRIVE_SMTP_PORT=587
NOUS_DRIVE_SMTP_USER=
NOUS_DRIVE_SMTP_PASSWORD=
NOUS_DRIVE_SMTP_FROM=
NOUS_DRIVE_NOTIFY_EMAIL_TO=
NOUS_DRIVE_NOTIFY_WINDOW_SECONDS=180

# --- Phase 2 (content). ON by default: text extraction + in-house embeddings, queued as jobs.
# No LLM is used unless you set SUMMARY_PROVIDER=ollama or claude. No API keys needed.
NOUS_DRIVE_CONTENT_ENABLED=true
NOUS_DRIVE_EMBEDDING_PROVIDER=fastembed    # fastembed (in-house model, default) | hash | voyage (paid)
NOUS_DRIVE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NOUS_DRIVE_EMBEDDING_CACHE_DIR=            # where the model is stored (downloaded once, ~220 MB)
NOUS_DRIVE_SUMMARY_PROVIDER=extractive     # extractive (free, default) | ollama (in-house LLM) | claude (paid)
NOUS_DRIVE_OLLAMA_URL=http://localhost:11434
NOUS_DRIVE_OLLAMA_MODEL=qwen2.5:3b
NOUS_DRIVE_SUMMARY_MAX_INPUT_CHARS=24000
# Only for SUMMARY_PROVIDER=claude (pip install ".[claude]"); cheapest model by default
NOUS_DRIVE_SUMMARY_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# Only for EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=

# --- tuning (defaults shown)
NOUS_DRIVE_DRIVE_POLL_SECONDS=300
NOUS_DRIVE_RECONCILE_HOURS=24
NOUS_DRIVE_RETENTION_DAYS=90
NOUS_DRIVE_DRIVE_MAX_RPS=8
NOUS_DRIVE_WORKER_CONCURRENCY=4
