# --- required
NOUS_DRIVE_DATABASE_URL=postgresql://postgres:postgres@db:5432/nous
NOUS_DRIVE_SECRET_KEY=change-me-long-random-string
# Fernet key for OAuth tokens at rest:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOUS_DRIVE_ENCRYPTION_KEY=
# Public HTTPS URL of the API (OAuth redirect, Drive webhooks, links in MCP results)
NOUS_DRIVE_PUBLIC_BASE_URL=https://drive.nous.example

# --- Google OAuth client (Web application). Redirect URI: <PUBLIC_BASE_URL>/oauth/google/callback
NOUS_DRIVE_GOOGLE_CLIENT_ID=
NOUS_DRIVE_GOOGLE_CLIENT_SECRET=

# --- notifications outside MCP (any combination; leave empty to disable)
NOUS_DRIVE_SLACK_WEBHOOK_URL=
NOUS_DRIVE_NOTIFY_WEBHOOK_URL=
NOUS_DRIVE_SMTP_HOST=
NOUS_DRIVE_SMTP_PORT=587
NOUS_DRIVE_SMTP_USER=
NOUS_DRIVE_SMTP_PASSWORD=
NOUS_DRIVE_SMTP_FROM=
NOUS_DRIVE_NOTIFY_EMAIL_TO=
NOUS_DRIVE_NOTIFY_WINDOW_SECONDS=180

# --- Phase 2 (content). Off by default; also switch on per source in its settings.
NOUS_DRIVE_CONTENT_ENABLED=false
NOUS_DRIVE_EMBEDDING_PROVIDER=local        # local | voyage
VOYAGE_API_KEY=
NOUS_DRIVE_SUMMARY_PROVIDER=claude         # claude | extractive
NOUS_DRIVE_SUMMARY_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- tuning (defaults shown)
NOUS_DRIVE_DRIVE_POLL_SECONDS=300
NOUS_DRIVE_RECONCILE_HOURS=24
NOUS_DRIVE_RETENTION_DAYS=90
NOUS_DRIVE_DRIVE_MAX_RPS=8
NOUS_DRIVE_WORKER_CONCURRENCY=4
